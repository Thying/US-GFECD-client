{
  "name": "@us-gfecd/client",
  "version": "0.0.3",
  "bin": {
    "us-gfecd": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Client library for US-GFECD architecture",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "lint": "eslint src --ext .js,.jsx",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "gfecd:init": "node bin/cli.js init"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Thying/US-GFECD-client.git"
  },
  "keywords": [
    "socket.io",
    "redux",
    "architecture"
  ],
  "author": "Thying",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-redux": ">=8.0.0",
    "socket.io-client": ">=4.5.0"
  },
  "devDependencies": {
    "@babel/core": "7.24.5",
    "@babel/preset-env": "7.24.5",
    "@babel/preset-react": "7.24.1",
    "@reduxjs/toolkit": "2.0.1",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "25.0.8",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "14.3.1",
    "babel-jest": "29.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.2",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "8.1.3",
    "rollup": "3.29.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(socket.io-client|engine.io-client|@socket.io|@us_gfecd)/)"
    ]
  }
}